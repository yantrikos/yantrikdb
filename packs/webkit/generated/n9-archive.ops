SITE name="Reel North" nav="Research,Digital Access,History" location="Sheffield" contact="archives@reelnorth.org"
THEME family=editorial accent=#8b0000 mode=light density=tight
SECTION  id=s1  kind=hero  layout=split  tone=quiet
TEXT sec=s1 slot=eyebrow text="Preserving Sheffield's television history"
TEXT sec=s1 slot=title text="Twelve thousand reels [digitised at 4K]"
TEXT sec=s1 slot=lede text="This archive holds regional broadcasts from 1957 to 1994, now preserved in high definition. Researchers can visit our facility three days a week for free."
ACTION sec=s1 slot=primary label="View collection times" href="#times"
ACTION sec=s1 slot=secondary label="Contact the archivists" href="#contact"
MEDIA sec=s1 slot=figure motif=elevation
SECTION  id=s2  kind=proof  layout=stack  tone=bold
TEXT sec=s2 slot=eyebrow text="Collection statistics"
TEXT sec=s2 slot=title text="The archive's core holdings [and access]"
ITEM sec=s2 slot=item title="12,400 reels" body="Total tapes preserved in the vault."
ITEM sec=s2 slot=item title="3 days" body="Weekly opening schedule for researchers."
SECTION  id=s3  kind=detail  layout=split  tone=quiet
TEXT sec=s3 slot=eyebrow text="The only facility with original 1960s broadcast masters"
TEXT sec=s3 slot=title text="Original [glass] negatives from the city's first station"
TEXT sec=s3 slot=lede text="While other archives hold copies or summaries, we retain the fragile glass negatives shot on location during the industrial era. These physical objects allow historians to verify original broadcast content against later edited versions."
ACTION sec=s3 slot=primary label="Request access form" href="#access"
MEDIA sec=s3 slot=figure motif=elevation
SECTION  id=s4  kind=features  layout=list  tone=quiet
TEXT sec=s4 slot=eyebrow text="Regional broadcasts from 1957 to 1994"
TEXT sec=s4 slot=title text="The industrial era [on tape]"
ITEM sec=s4 slot=item title="Sheffield Steelworks Newsreel" body="A forty-minute report filmed on location in the city centre, featuring interviews with shift supervisors and a tour of the blast furnaces."
ITEM sec=s4 slot=item title="Winter 1962 Weather Report" body="Footage captured during a severe snowstorm that grounded flights at Doncaster airport, showing ploughs clearing Main Street while traffic lights remained unpowered."
ITEM sec=s4 slot=item title="School Leaving Ceremony 1978" body="A twenty-minute recording of the annual graduation held in the town hall auditorium, where students wore formal gowns and received certificates from the headmaster."
ITEM sec=s4 slot=item title="Factory Safety Inspection Log" body="A fifteen-second clip documenting a routine check of emergency exits at the textile mill, noting that all doors were unlocked and signage was legible despite soot stains."
SECTION  id=s5  kind=cta  layout=stack  tone=quiet
TEXT sec=s5 slot=title text="Visit three days a week to view digitised masters"
TEXT sec=s5 slot=lede text="Researchers arrive with their own equipment; archivists assist on request."
ACTION sec=s5 slot=primary label="Book your viewing session" href="#book
