SITE     name="Reel North"  nav="Archive,Collections,Visit"  location="Sheffield"  contact="research@reelnorth.ac.uk"
THEME    family=technical  accent=#0f4c75  mode=dark  density=tight
SECTION  id=s1  kind=hero  layout=split  tone=quiet
TEXT     sec=s1  slot=eyebrow  text="Reel North"
TEXT     sec=s1  slot=title    text="A [film] archive in Sheffield."
TEXT     sec=s1  slot=lede     text="Holds twelve thousand reels of regional television from nineteen fifty-seven to ninety-four, digitised at four K. Open to researchers three days a week for free with two archivists on staff."
ACTION   sec=s1  slot=primary  label="View the collection"  href="#archive"
ACTION   sec=s1  slot=secondary label="Visit us in Sheffield"  href="#visit"
MEDIA    sec=s1  slot=figure  motif=schematic
