SECTION  id=s3  kind=detail  layout=split  tone=quiet
TEXT     sec=s3  slot=eyebrow    text="Reel North"
TEXT     sec=s3  slot=title       text="A [film] archive in Sheffield."
TEXT     sec=s3  slot=lede       text="The only regional television collection digitised at four K, preserved by two archivists for free access. No other institution holds twelve thousand reels from nineteen fifty-seven to ninety-four under one roof."
ACTION   sec=s3  slot=primary    label="Request a viewing"  href="#request"
MEDIA    sec=s3  slot=figure     motif=dial
SECTION  id=s4  kind=features  layout=list  tone=quiet
TEXT     sec=s4  slot=item    title="Regional television"   body="Footage from Yorkshire and Lancashire captured on film stock before digital conversion."
ITEM      sec=s4  slot=item    title="1957 to 1994"           body="The span of regional broadcasting coverage preserved in the collection's core holdings."
ITEM      sec=s4  slot=item    title="Four K resolution"     body="Digitised at four thousand lines per frame for maximum archival clarity and longevity."
ITEM      sec=s4  slot=item    title="Two archivists on staff"   body="Curators manage access protocols during the three days each week researchers are permitted to view materials in person or remotely."
SECTION  id=s5  kind=roster  layout=stack  tone=quiet
TEXT     sec=s5  slot=eyebrow    text="Reel North"
TEXT     sec=s5  slot=title       text="A [film] archive in Sheffield."
ITEM      sec=s5  slot=item      title="Viewing room access"   body="Researchers may view materials on-site or remotely during the three days each week, with protocols managed by two archivists for free of charge."
ITEM      sec=s5  slot=item      title="Digital catalogue search"    body="The collection's core holdings from nineteen fifty-seven to ninety-four are searchable online at four thousand lines per frame resolution."
ITEM      sec=s5  slot=item      title="Regional broadcast archive"   body="Footage from Yorkshire and Lancashire captured on film stock before digital conversion is preserved under one roof for maximum archival clarity."
