SECTION  id=s4  kind=features  layout=list  tone=quiet
TEXT     sec=s4  slot=eyebrow    text="Preserving regional television history"
ITEM      sec=s4  slot=item       title="1957-1994"   body="Regional broadcasts from Sheffield and surrounding counties, preserved on magnetic tape."
ITEM      sec=s4  slot=item       title="4K resolution"     body="Digitised at four thousand pixels per side for maximum clarity in archival research."
ITEM      sec=s4  slot=item       title="Magnetic tape"    body="Original reels stored in climate-controlled vaults, accessible only by appointment during working hours."
TEXT     sec=s4  slot=title      text="Reel North [holds twelve thousand reels]"
SECTION  id=s5  kind=roster  layout=stack  tone=quiet
TEXT     sec=s5  slot=eyebrow    text="Services and access"
TEXT     sec=s5  slot=title      text="Reel North [holds twelve thousand reels]"
ITEM      sec=s5  slot=item       title="Research consultation"   body="One-on-one sessions with archivists to locate footage, available by appointment during working hours."
ITEM      sec=s5  slot=item       title="Digital access"         body="Secure download of digitised clips for accredited researchers and educational institutions worldwide."
ITEM      sec=s5  slot=item       title="On-site viewing"        body="Private screening rooms in the archive, open to registered users three days a week by prior arrangement."
