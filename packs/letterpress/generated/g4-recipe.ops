SITE name="Tide Mill" nav="Bread,Visit,Contact" location="Bristol" contact="hello@tidemill.co"
THEME family=editorial accent=#b8442f mode=light density=roomy
SECTION  id=s1  kind=hero  layout=split  tone=quiet
TEXT sec=s1 slot=eyebrow text="Seeded rye sourdough"
TEXT sec=s1 slot=title text="Bread [worth the walk]"
TEXT sec=s1 slot=lede text="Two ovens and no cafe, but forty loaves of dark grain waiting to rise. The long ferment turns simple flour into something that tastes like history."
ACTION sec=s1 slot=primary label="Collection times" href="#times"
ACTION sec=s1 slot=secondary label="Ingredients list" href="#ingredients"
MEDIA sec=s1 slot=figure motif=lattice
SECTION  id=s2  kind=proof  layout=stack  tone=bold
TEXT sec=s2 slot=eyebrow text="The recipe at a glance"
TEXT sec=s2 slot=title text="Sourdough [in numbers]"
ITEM sec=s2 slot=item title="12" body="Loaves served."
ITEM sec=s2 slot=item title="30 minutes" body="Work time required."
ITEM sec=s2 slot=item title="18 hours" body="Proving duration."
ITEM sec=s2 slot=item title="45 minutes" body="Baking at high heat."
SECTION  id=s3  kind=detail  layout=split  tone=quiet
TEXT sec=s3 slot=eyebrow text="The secret ingredient"
TEXT sec=s3 slot=title text="History [in every crumb]"
TEXT sec=s3 slot=lede text="While competitors rush with commercial yeast, we rely on a starter fed daily for three years. This slow fermentation builds complex sugars that digest easily and feed the gut long after you finish eating."
ACTION sec=s3 slot=primary label="Read full method" href="#method"
MEDIA sec=s3 slot=figure motif=strata
SECTION  id=s4  kind=roster  layout=stack  tone=bold
TEXT sec=s4 slot=eyebrow text="Ingredients"
TEXT sec=s4 slot=title text="The [base] mix"
ITEM sec=s4 slot=item title="400g rye flour" body="sifted, at room temperature."
ITEM sec=s4 slot=item title="100g strong white" body="to lighten the crumb structure."
ITEM sec=s4 slot=item title="320g water" body="filtered or spring source preferred."
SECTION  id=s5  kind=features  layout=list  tone=quiet
TEXT sec=s5 slot=eyebrow text="The method"
TEXT sec=s5 slot=title text="[Mix] and [rest]"
ITEM sec=s5 slot=item title="Autolyse" body="Combine flour, water, and seeds; let the gluten hydrate for twenty minutes before adding anything else."
ITEM sec=s5 slot=item title="First fold" body="Add starter and salt to the wet mix, then perform a series of gentle folds until the dough holds its shape after thirty seconds."
ITEM sec=s5 slot=item title="Bulk ferment" body="Cover the bowl with plastic wrap and let it rise at room temperature for six hours, watching for bubbles along the sides."
ITEM sec=s5 slot=item title="Shape and proof" body="Turn out onto a floured surface, shape into two loaves, place in bannetons, and wait eight to ten hours until doubled in size."
SECTION  id=s6  kind=cta  layout=stack  tone=quiet
TEXT sec=s6 slot=title text="Come [after six]"
TEXT sec=s6 slot=lede text="Pick up your loaf when the starter is fed and the dough has doubled."
ACTION sec=s6 slot=primary label="Check collection hours" href="#times"
