SITE name="Tide Mill" nav="Bread,Visit,Contact" location="Bristol" contact="hello@tidemill.co"
THEME family=editorial accent=#b8442f mode=light density=roomy
SECTION  id=s1  kind=hero  layout=split  tone=quiet
TEXT sec=s1 slot=eyebrow text="Seeded rye sourdough"
TEXT sec=s1 slot=title text="Bread [worth the walk]"
SECTION  id=s2  kind=proof  layout=stack  tone=bold
TEXT sec=s2 slot=eyebrow text="12 servings"
TEXT sec=s2 slot=title text="30 minutes [work]"
ITEM sec=s2 slot=item title="12" body="Servings."
ITEM sec=s2 slot=item title="30 minutes" body="Work time."
ITEM sec=s2 slot=item title="18 hours" body="Proving time."
ITEM sec=s2 slot=item title="45 minutes" body="Baking time."
ITEM sec=s2 slot=item title="230C" body="Oven temperature."
SECTION  id=s3  kind=detail  layout=split  tone=quiet
TEXT sec=s3 slot=eyebrow text="The starter"
TEXT sec=s3 slot=title text="Wild yeast [fed daily]"
TEXT sec=s3 slot=lede text="We maintain a living culture in the cellar, feeding it twice every morning so that by evening we have enough active bubbles to start twelve loaves. This rhythm has kept our sourdough alive for twenty years without interruption."
ACTION sec=s3 slot=primary label="Start your own" href="#starter-guide"
MEDIA sec=s3 slot=figure motif=strata
SECTION  id=s4  kind=roster  layout=stack  tone=bold
TEXT sec=s4 slot=eyebrow text="Ingredients"
TEXT sec=s4 slot=title text="The dough [and seeds]"
ITEM sec=s4 slot=item title="400g rye flour" body="sifted."
ITEM sec=s4 slot=item title="100g strong white" body="at room temperature."
ITEM sec=s4 slot=item title="320g water" body="chilled from the tap."
SECTION  id=s5  kind=features  layout=list  tone=quiet
TEXT sec=s5 slot=eyebrow text="Method"
TEXT sec=s5 slot=title text="The process [is slow]"
ITEM sec=s5 slot=item title="Autolyse" body="Mix flour and water, let rest for twenty minutes."
ITEM sec=s5 slot=item title="Add starter" body="Fold in the culture until it is evenly distributed throughout."
ITEM sec=s5 slot=item title="First rise" body="Cover with a cloth and leave to double at room temperature."
ITEM sec=s5 slot=item title="Shape and bake" body="Dust, fold into loaves, score tops, then slide onto hot stone."
SECTION  id=s6  kind=cta  layout=stack  tone=quiet
TEXT sec=s6 slot=title text="Come back at dawn"
TEXT sec=s6 slot=lede text="First batch ready for tomorrow."
ACTION sec=s6 slot=primary label="Book your loaf" href="#times"
