SITE name="Tide Mill" nav="Bread,Visit,Contact" location="Bristol" contact="hello@tidemill.co"
THEME family=editorial accent=#b8442f mode=light density=roomy
SECTION  id=s1  kind=hero  layout=split  tone=quiet
TEXT sec=s1 slot=eyebrow text="Seeded rye sourdough"
TEXT sec=s1 slot=title text="Bread [worth the walk]"
SECTION  id=s2  kind=proof  layout=stack  tone=bold
TEXT sec=s2 slot=eyebrow text="Serves 12"
TEXT sec=s2 slot=title text="Time [and heat]"
ITEM sec=s2 slot=item title="30 minutes" body="Work time."
ITEM sec=s2 slot=item title="18 hours" body="Proving time."
ITEM sec=s2 slot=item title="45 minutes" body="Baking time."
ITEM sec=s2 slot=item title="230C" body="Oven temperature."
SECTION  id=s3  kind=detail  layout=split  tone=quiet
TEXT sec=s3 slot=eyebrow text="The starter"
TEXT sec=s3 slot=title text="Feeding [the wild yeast]"
TEXT sec=s3 slot=lede text="We maintain a living culture of lactobacilli and candida in our cellar. This specific blend ferments rye faster than any commercial powder, giving the crust its signature snap."
ACTION sec=s3 slot=primary label="Start now" href="#recipe"
MEDIA sec=s3 slot=figure photo="sourdough starter jar bubbles"
SECTION  id=s4  kind=roster  layout=stack  tone=bold
TEXT sec=s4 slot=eyebrow text="Ingredients"
TEXT sec=s4 slot=title text="The [mix]"
ITEM sec=s4 slot=item title="400g rye flour" body="sifted."
ITEM sec=s4 slot=item title="100g strong white" body="at room temperature."
ITEM sec=s4 slot=item title="320g water" body="filtered if possible."
SECTION  id=s5  kind=features  layout=list  tone=quiet
TEXT sec=s5 slot=eyebrow text="Method"
TEXT sec=s5 slot=title text="[Knead] the dough"
ITEM sec=s5 slot=item title="Mix and autolyse" body="Combine flour, water, and starter in a bowl. Let rest for 30 minutes."
ITEM sec=s5 slot=item title="Add salt and seeds" body="Sprinkle salt over the surface, then scatter mixed seeds on top before folding."
ITEM sec=s5 slot=item title="Bulk fermentation" body="Perform stretches every hour until doubled in size after four hours total."
ITEM sec=s5 slot=item title="Shape and proof" body="Gently shape into a round loaf. Cover and let rise for 4 to 6 hours at room temperature."
SECTION  id=s6  kind=cta  layout=stack  tone=quiet
TEXT sec=s6 slot=title text="Come back for [the second batch]"
TEXT sec=s6 slot=lede text="First loaves sell out by noon."
ACTION sec=s6 slot=primary label="Order now" href="#order"
