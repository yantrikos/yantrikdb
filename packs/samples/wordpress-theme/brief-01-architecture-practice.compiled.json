{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "name": "Slab Display",
          "slug": "slab-display",
          "fontFamily": "'Roboto Slab', 'Noto Serif Display', serif"
        },
        {
          "name": "Neutral Grotesque",
          "slug": "neutral-grotesque",
          "fontFamily": "'Inter', 'Helvetica Neue', Arial, sans-serif"
        }
      ],
      "fontSizes": [
        {
          "name": "Tiny",
          "slug": "tiny",
          "size": "0.75rem"
        },
        {
          "name": "Small",
          "slug": "small",
          "size": "0.875rem"
        },
        {
          "name": "Base",
          "slug": "base",
          "size": "1rem"
        },
        {
          "name": "Medium",
          "slug": "medium",
          "size": "1.25rem"
        },
        {
          "name": "Large",
          "slug": "large",
          "size": "1.563rem"
        },
        {
          "name": "X-Large",
          "slug": "x-large",
          "size": "1.953rem"
        }
      ]
    },
    "layout": {
      "contentSize": "38rem",
      "wideSize": "75rem"
    },
    "color": {
      "palette": [
        {
          "name": "Base",
          "slug": "base",
          "color": "#f5f4f0"
        },
        {
          "name": "Contrast",
          "slug": "contrast",
          "color": "#2b2a26"
        },
        {
          "name": "Primary",
          "slug": "primary",
          "color": "#c4b5a0"
        },
        {
          "name": "Secondary",
          "slug": "secondary",
          "color": "#a8b8b3"
        }
      ]
    },
    "spacing": {
      "spacingSizes": [
        {
          "name": "XS",
          "size": "0.5rem",
          "slug": "xs"
        },
        {
          "name": "S",
          "size": "1rem",
          "slug": "s"
        },
        {
          "name": "M",
          "size": "1.5rem",
          "slug": "m"
        },
        {
          "name": "L",
          "size": "2.5rem",
          "slug": "l"
        },
        {
          "name": "XL",
          "size": "4rem",
          "slug": "xl"
        }
      ]
    },
    "useRootPaddingAwareAlignments": true
  },
  "styles": {
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--neutral-grotesque)",
      "fontSize": "var(--wp--preset--font-size--base)",
      "lineHeight": "1.6"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--slab-display)"
        }
      },
      "h1": {
        "typography": {
          "lineHeight": "1.15"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--primary)"
        }
      }
    },
    "color": {
      "background": "var(--wp--preset--color--base)",
      "text": "var(--wp--preset--color--contrast)"
    },
    "spacing": {
      "blockGap": "var(--wp--preset--spacing--m)",
      "padding": {
        "top": "var(--wp--preset--spacing--m)",
        "right": "var(--wp--preset--spacing--l)",
        "bottom": "var(--wp--preset--spacing--m)",
        "left": "var(--wp--preset--spacing--l)"
      }
    }
  }
}