            400,
            500,
            600,
            700
          ],
          "fontStyles": [
            "normal",
            "italic"
          ],
          "textTransform": "none"
        },
        {
          "name": "Neutral Grotesque",
          "slug": "neutral-grotesque",
          "fontFamily": "sans-serif",
          "fontWeights": [
            300,
            400,
            500,
            600
          ],
          "fontStyles": [
            "normal",
            "italic"
          ],
          "textTransform": "none"
        }
      ],
      "defaultFontFamily": "neutral-grotesque"
