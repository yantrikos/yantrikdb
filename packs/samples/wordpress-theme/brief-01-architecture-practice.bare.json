          "medium": {
            "fontFamily": "slab-display",
            "fontWeight": 500,
            "fontSize": "32px",
            "lineHeight": 1.2,
            "letterSpacing": "-0.01em"
          },
          "small": {
            "fontFamily": "slab-display",
            "fontWeight": 400,
            "fontSize": "24px",
            "lineHeight": 1.3,
            "letterSpacing": "0"
          }
        },
        "textStyle": {
          "normal": {
            "fontFamily": "slab-display",
            "fontWeight": 400,
            "fontSize": "16px",
            "lineHeight": 1.6,
            "letterSpacing": "0"
          }
        }
      }
    },
    "core/paragraph": {
      "style": {
        "size": {
          "large": {
            "fontFamily": "neutral-grotesque",
            "fontWeight": 300,
            "fontSize": "24px",
            "lineHeight": 1.5,
            "letterSpacing": "0"
