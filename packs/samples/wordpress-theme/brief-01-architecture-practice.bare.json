    "core/button": {
      "style": {
        "borderRadius": 0,
        "spacing": {
          "padding": {
            "top": "12px",
            "right": "24px",
            "bottom": "12px",
            "left": "24px"
          }
        },
        "typography": {
          "fontFamily": "neutral-grotesque",
          "fontWeight": 500,
          "fontSize": "14px",
          "textTransform": "uppercase",
          "letterSpacing": "0.05em"
