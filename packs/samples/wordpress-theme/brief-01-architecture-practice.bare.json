        {
          "name": "White",
          "slug": "white",
          "color": "#ffffff"
        },
        {
          "name": "Off-White",
          "slug": "off-white",
          "color": "#f4f4f0"
        },
        {
          "name": "Sand",
          "slug": "sand",
          "color": "#e6e2d8"
        },
        {
          "name": "Pale Blue",
          "slug": "pale-blue",
          "color": "#eef2f5"
        },
        {
          "name": "Muted Sage",
          "slug": "muted-sage",
          "color": "#d8e2dc"
        },
        {
          "name": "Charcoal",
          "slug": "charcoal",
          "color": "#2a2a2a"
        }
      ],
      "defaultPalette": [
        "white",
        "off-white",
        "sand",
        "pale-blue",
        "muted-sage",
        "charcoal"
      ]
