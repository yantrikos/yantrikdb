          "medium": {
            "fontFamily": "neutral-grotesque",
            "fontWeight": 400,
            "fontSize": "18px",
            "lineHeight": 1.6,
            "letterSpacing": "0"
          },
          "small": {
            "fontFamily": "neutral-grotesque",
            "fontWeight": 400,
            "fontSize": "16px",
            "lineHeight": 1.6,
            "letterSpacing": "0"
